# =========================================================
# Konfigurasi Backend - E-Rapor TPQ Baitur Rouf Surabaya
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# =========================================================

# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=e_rapor_tpq
DB_USER=erapor
DB_PASSWORD=ubah-password-database-anda
DB_DIALECT=mysql

# --- Keamanan ---
# WAJIB diganti dengan string acak panjang sebelum produksi.
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# --- CORS ---
# Asal frontend yang diizinkan, pisahkan dengan koma.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# --- Perhitungan SAW ---
# Toleransi selisih total bobot kriteria terhadap 1 (floating point).
SAW_BOBOT_TOLERANCE=0.001

# --- Logging ---
LOG_LEVEL=info
